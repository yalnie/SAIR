<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme.Light" parent="Theme.Material3.Light.NoActionBar">
        <!-- Edge to edge is mandatory from API 35; opt out of the system's contrast scrims and
             pick the system bar icon colour to match this theme. -->
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:statusBarColor">@color/md_theme_light_surface</item>
        <item name="android:navigationBarColor" tools:targetApi="27">@color/md_theme_light_surface</item>

        <!-- Material 3 Light Color Roles -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/md_theme_light_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_light_inversePrimary</item>
        <item name="colorSurfaceDim">@color/md_theme_light_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md_theme_light_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_light_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_light_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_light_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_light_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_light_surfaceContainerHighest</item>

        <!-- App specific / legacy view bindings -->
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorPrimaryDark">@color/md_theme_light_surface</item>
        <item name="colorPrimaryLight">@color/md_theme_light_surfaceContainerLow</item>
        <item name="android:windowBackground">@color/md_theme_light_background</item>
        <item name="titleTextColor">@color/md_theme_light_onSurface</item>
        <item name="android:textColorPrimary">@color/md_theme_light_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>

        <item name="alertDialogTheme">@style/AlertDialog.AppTheme.Light</item>
        <item name="materialAlertDialogTheme">@style/AlertDialog.AppTheme.Light</item>
        <item name="bottomSheetDialogTheme">@style/SAIBottomSheetDialog.Backup.Light</item>
        <item name="android:textViewStyle">@style/SAITextViewStyle</item>
        <item name="filePickerDialogSelectButtonStyle">@style/SAIMaterialButton</item>
        <item name="filePickerDialogCancelButtonStyle">@style/SAIMaterialButton.Outlined</item>
        <item name="popupMenuStyle">@style/SAIPopupMenu.Light</item>
        <item name="popupMenuBackgroundTint">?colorPrimaryLight</item>
    </style>

    <style name="AppTheme.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Edge to edge is mandatory from API 35; opt out of the system's contrast scrims and
             pick the system bar icon colour to match this theme. -->
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:statusBarColor">@color/md_theme_dark_surface</item>
        <item name="android:navigationBarColor" tools:targetApi="27">@color/md_theme_dark_surface</item>

        <!-- Material 3 Dark Color Roles -->
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_dark_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_dark_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_dark_error</item>
        <item name="colorOnError">@color/md_theme_dark_onError</item>
        <item name="colorErrorContainer">@color/md_theme_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_dark_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorOnBackground">@color/md_theme_dark_onBackground</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_dark_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/md_theme_dark_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_dark_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_dark_inversePrimary</item>
        <item name="colorSurfaceDim">@color/md_theme_dark_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md_theme_dark_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_dark_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_dark_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_dark_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_dark_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_dark_surfaceContainerHighest</item>

        <!-- App specific / legacy view bindings -->
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorPrimaryDark">@color/md_theme_dark_surface</item>
        <item name="colorPrimaryLight">@color/md_theme_dark_surfaceContainerLow</item>
        <item name="android:windowBackground">@color/md_theme_dark_background</item>
        <item name="titleTextColor">@color/md_theme_dark_onSurface</item>
        <item name="android:textColorPrimary">@color/md_theme_dark_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>

        <item name="alertDialogTheme">@style/AlertDialog.AppTheme.Dark</item>
        <item name="materialAlertDialogTheme">@style/AlertDialog.AppTheme.Dark</item>
        <item name="bottomSheetDialogTheme">@style/SAIBottomSheetDialog.Backup</item>
        <item name="android:textViewStyle">@style/SAITextViewStyle</item>
        <item name="filePickerDialogSelectButtonStyle">@style/SAIMaterialButton</item>
        <item name="filePickerDialogCancelButtonStyle">@style/SAIMaterialButton.Outlined</item>
        <item name="popupMenuStyle">@style/SAIPopupMenu.Dark</item>
        <item name="popupMenuBackgroundTint">?colorPrimaryLight</item>
    </style>

    <style name="SAIMaterialButton" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="iconPadding">3dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="SAIMaterialButton.Slim" parent="SAIMaterialButton">
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconPadding">1dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <style name="SAIMaterialButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/selector_outlined_button_text_color</item>
        <item name="iconTint">@color/selector_outlined_button_text_color</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/selector_outlined_button_outline_color</item>
        <item name="iconPadding">3dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="SAIMaterialButton.Outlined.Slim" parent="SAIMaterialButton.Outlined">
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconPadding">1dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <style name="SAIMaterialButton.ExtendedFab" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="elevation">3dp</item>
    </style>

    <style name="SAICoolbarImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">?attr/colorAccent</item>
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
    </style>

    <style name="SAITextViewStyle" parent="Base.Widget.AppCompat.TextView">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="SAIBottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?android:attr/windowBackground</item>
        <item name="itemIconTint">@color/selector_bottom_navigation</item>
        <item name="itemTextColor">@color/selector_bottom_navigation</item>
    </style>

    <style name="AlertDialog.AppTheme.Light" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_rounded_alert_dialog</item>
        <item name="android:backgroundTint">?attr/colorSurface</item>
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="textColorAlertDialogListItem">?android:attr/textColorSecondary</item>
    </style>

    <style name="AlertDialog.AppTheme.Dark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_rounded_alert_dialog</item>
        <item name="android:backgroundTint">?attr/colorSurface</item>
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="textColorAlertDialogListItem">?android:attr/textColorSecondary</item>
    </style>

    <style name="SAIPopupMenu.Light" parent="Widget.AppCompat.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_rounded_popup</item>
    </style>

    <style name="SAIPopupMenu.Dark" parent="Widget.AppCompat.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_rounded_popup</item>
    </style>

    <style name="SAIChip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:checkable">true</item>
        <item name="chipBackgroundColor">@color/selector_chip_background_color_filter</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="checkedIcon">@drawable/ic_chip_checked</item>
    </style>

    <style name="SAIChip.Selection" parent="Widget.Material3.Chip.Suggestion">
        <item name="android:checkable">true</item>
        <item name="chipBackgroundColor">@color/selector_chip_background_color_selection</item>
        <item name="chipSurfaceColor">?colorPrimary</item>
        <item name="android:textColor">@color/selector_chip_text_color_selection</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="SAITextInputLayout.OutlinedBox.Dense" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusBottomEnd">@dimen/textinputlayout_box_corners_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/textinputlayout_box_corners_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/textinputlayout_box_corners_radius</item>
        <item name="boxCornerRadiusTopStart">@dimen/textinputlayout_box_corners_radius</item>
        <item name="android:backgroundTint">?attr/colorAccent</item>
        <item name="boxStrokeColor">?attr/colorAccent</item>
        <item name="hintTextColor">?attr/colorAccent</item>
    </style>

    <style name="SAIBottomSheetDialog.Backup" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/SAIBottomSheetDialogStyle.Backup</item>
    </style>

    <style name="SAIBottomSheetDialog.Backup.Light" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/SAIBottomSheetDialogStyle.Backup</item>
    </style>

    <style name="SAIBottomSheetDialogStyle.Backup" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="FeatureChipTextAppearance" parent="TextAppearance.AppCompat.Small">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="SAITooltipTextAppearance" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="ThemeView.Normal.Interactive" parent="Widget.Material3.CardView.Outlined">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">88dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="contentPadding">8dp</item>
        <item name="strokeWidth">2dp</item>
    </style>

</resources>
